{
  "name": "quality-ratchet",
  "version": "2.0.0",
  "description": "Fails a pull request when a quality metric regresses against its baseline.",
  "type": "module",
  "license": "MIT",
  "author": "Luis Fernandes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuisFernandes664/quality-ratchet.git"
  },
  "keywords": [
    "github-action",
    "quality-gate",
    "ratchet",
    "coverage",
    "mutation-testing",
    "baseline",
    "ci"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "quality-ratchet": "bin/quality-ratchet.js"
  },
  "exports": {
    ".": "./src/core/ratchet.js",
    "./extractors": "./src/extractors/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "schema/",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "~20.19.0",
    "typescript": "~5.9.3"
  }
}
